(ns xsofy.main
  (:require [term]
            [os]
            [js]
            [io :refer [write! flush! *err*]]
            [string]
            [xsofy.world :as world]
            [xsofy.entities :as ent]
            [xsofy.render :as render]
            [xsofy.ui :as ui]
            [xsofy.runes :as runes]
            [xsofy.play :as play]
            [xsofy.title :as title]
            [xsofy.screenfx :as sfx]
            [xsofy.debug :as dbg]
            [xsofy.dispatch :as dispatch]
            [xsofy.console :as console]
            [xsofy.seed :as seed]
            [xsofy.replay :as replay]
            [xsofy.ui-bridge :as bridge]))


(defn init-terminal []
  (when (nil? (term/size))
    (println "Not a terminal.")
    (os/exit 1))
  (term/raw-mode!)
  (term/alternate-screen)
  (term/hide-cursor)
  (term/clear))

(defn shutdown-terminal []
  (term/reset-style)
  (term/show-cursor)
  (term/main-screen)
  (term/flush)
  (term/restore-mode!))

(def inv-letters "abcdefghijklmnopqrstuvwxyz")

(defn letter-to-index [k]
  (string/index-of inv-letters k))

(defn get-item-name [world item-id]
  (let [item (get-in world [:entities item-id])]
    (or (:item-name item) (name (or (:template item) (:id item) :unknown)))))

(defn inv-sel [world]
  (or (:inv-sel world) -1))

(defn inv-count [world]
  (count (or (get-in world [:entities :player :inventory]) [])))

(defn sel-item-id [world]
  (let [inv (or (get-in world [:entities :player :inventory]) [])
        sel (inv-sel world)]
    (when (and (>= sel 0) (< sel (count inv)))
      (nth inv sel nil))))

;; The inventory-screen item actions, like the quick-menu, route world-mutating
;; actions through dispatch (seed + :action-log) — guards/messages live in
;; world's *-action handlers — and only manage the :inventory screen state here.

(defn inv-equip [world]
  (if-let [item-id (sel-item-id world)]
    (-> (dispatch/dispatch world {:type :equip :id item-id})
        (assoc :screen :inventory))
    (assoc world :screen :inventory)))

(defn inv-unequip [world]
  (if-let [item-id (sel-item-id world)]
    (-> (dispatch/dispatch world {:type :unequip :id item-id})
        (assoc :screen :inventory))
    (assoc world :screen :inventory)))

(defn inv-drop [world]
  (if-let [item-id (sel-item-id world)]
    (-> (dispatch/dispatch world {:type :drop :id item-id})
        (assoc :screen :inventory :inv-sel (max 0 (dec (inv-sel world)))))
    (assoc world :screen :inventory)))

(defn inv-use [world]
  (if-let [item-id (sel-item-id world)]
    (if (= :consumable (get-in world [:entities item-id :item :slot]))
      (let [result (dispatch/dispatch world {:type :use-item :id item-id})]
        ;; if use-item opened a submenu (enchant), keep its screen
        (if (:screen result)
          (dissoc result :inv-sel)
          (dissoc result :screen :inv-sel)))
      (assoc world :screen :inventory))
    (assoc world :screen :inventory)))

(defn inv-inscribe [world]
  (if-let [item-id (sel-item-id world)]
    (let [item (get-in world [:entities item-id])
          slot (get-in item [:item :slot])]
      (if (or (= slot :weapon) (= slot :armor))
        (-> world
            (assoc :screen :inscribe
                   :inscribe-item-id item-id
                   :inscribe-runes (vec (or (:runes item) []))
                   :inscribe-sel 0))
        (-> world
            (world/log-msg "You can only inscribe weapons and armor.")
            (assoc :screen :inventory))))
    (assoc world :screen :inventory)))

(defn inscribe-input [world k]
  (let [rune-table (or (:rune-table world) {})
        available (runes/inscribable-runes rune-table)
        sel (or (:inscribe-sel world) 0)
        runes (or (:inscribe-runes world) [])
        max-runes 12
        cnt (count available)]
    (cond
      ;; cancel
      (= k "\u001b")
      (-> world (dissoc :screen :inscribe-item-id :inscribe-runes :inscribe-sel))

      ;; navigate down
      (or (= k "j") (= k "\u001b[B"))
      (assoc world :inscribe-sel (min (dec cnt) (inc sel)))

      ;; navigate up
      (or (= k "k") (= k "\u001b[A"))
      (assoc world :inscribe-sel (max 0 (dec sel)))

      ;; navigate right (next column)
      (or (= k "l") (= k "\u001b[C"))
      (let [[tw th] (term/size)
            max-rows (- th 14)
            new-sel (min (dec cnt) (+ sel max-rows))]
        (assoc world :inscribe-sel new-sel))

      ;; navigate left (prev column)
      (or (= k "h") (= k "\u001b[D"))
      (let [[tw th] (term/size)
            max-rows (- th 14)
            new-sel (max 0 (- sel max-rows))]
        (assoc world :inscribe-sel new-sel))

      ;; add selected rune
      (and (= k " ") (< (count runes) max-runes) (> cnt 0) (< sel cnt))
      (let [rn (nth available sel)]
        (assoc world :inscribe-runes (conj runes (:rune rn))))

      ;; remove last rune
      (and (= k "x") (seq runes))
      (assoc world :inscribe-runes (vec (butlast runes)))

      ;; confirm inscription
      (= k "\r")
      (if (seq runes)
        (let [item-id (:inscribe-item-id world)
              w (world/inscribe-runes-on-item world item-id runes)]
          (-> w (dissoc :screen :inscribe-item-id :inscribe-runes :inscribe-sel)))
        (-> world (dissoc :screen :inscribe-item-id :inscribe-runes :inscribe-sel)))

      :else world)))

(defn inventory-input [world k]
  (let [sel (inv-sel world)
        cnt (inv-count world)]
    (cond
      ;; close — esc always, i only when nothing selected
      (= k "\u001b")
      (-> world (dissoc :screen :inv-sel))

      (and (= k "i") (< sel 0))
      (-> world (dissoc :screen :inv-sel))

      ;; navigate
      (or (= k "j") (= k "\u001b[B"))
      (assoc world :inv-sel (min (dec cnt) (inc sel)) :screen :inventory)

      (or (= k "k") (= k "\u001b[A"))
      (assoc world :inv-sel (max 0 (dec sel)) :screen :inventory)

      ;; deselect
      (= k " ")
      (assoc world :inv-sel -1 :screen :inventory)

      ;; actions on selected item (check before letter select)
      (and (>= sel 0) (= k "e")) (inv-equip world)
      (and (>= sel 0) (= k "U")) (inv-unequip world)
      (and (>= sel 0) (= k "d")) (inv-drop world)
      (and (>= sel 0) (= k "a")) (inv-use world)
      (and (>= sel 0) (= k "s")) (inv-inscribe world)

      ;; letter select
      (and (= 1 (count k)) (some? (letter-to-index k)))
      (let [idx (letter-to-index k)]
        (if (and idx (< idx cnt))
          (assoc world :inv-sel idx :screen :inventory)
          world))

      :else world)))

(defn execute-menu-action [world action inv-idx]
  (let [inv (or (get-in world [:entities :player :inventory]) [])
        item-id (nth inv inv-idx nil)
        old-screen (:screen world)]
    (if (nil? item-id)
      world
      (let [slot (get-in world [:entities item-id :item :slot])
            result (case action
                     ;; world-mutating menu actions go through dispatch so they
                     ;; fold into the seed + :action-log and replay identically.
                     ;; Guards/messages live in world's *-action handlers.
                     :equip   (dispatch/dispatch world {:type :equip :id item-id})
                     :unequip (dispatch/dispatch world {:type :unequip :id item-id})
                     :drop    (dispatch/dispatch world {:type :drop :id item-id})

                     :use
                     (if (= slot :consumable)
                       (dispatch/dispatch world {:type :use-item :id item-id})
                       world)

                     :enchant
                     (let [scroll-id (:enchant-scroll-id world)]
                       (if scroll-id
                         ;; dispatch the assembled (target, scroll) action so the
                         ;; enchant + scroll-consume fold into the seed + log
                         (-> (dispatch/dispatch world {:type :enchant :id item-id :scroll-id scroll-id})
                             (dissoc :enchant-scroll-id))
                         world))

                     world)]
        ;; Preserve submenu transitions when the action keeps us on a screen
        ;; because it changed the menu mode/state, even if the screen keyword
        ;; itself stayed :quick-menu (e.g. use -> enchant target select). Plain
        ;; mutating actions like drop/equip should still fall back to the game.
        (if (and (:screen result)
                 (or (not= (:screen result) old-screen)
                     (not= (:menu-action result) (:menu-action world))
                     (not= (:enchant-scroll-id result) (:enchant-scroll-id world))))
          (dissoc result :menu-sel)
          (dissoc result :screen :menu-action :menu-sel :enchant-scroll-id))))))

(defn quick-menu-input [world k]
  (let [action (or (:menu-action world) :equip)
        items (render/menu-filter world action)
        sel (or (:menu-sel world) -1)]
    (cond
      ;; cancel
      (= k "\u001b")
      (dissoc world :screen :menu-action :menu-sel)

      ;; navigate
      (or (= k "j") (= k "\u001b[B"))
      (assoc world :menu-sel (min (dec (count items)) (inc sel)))

      (or (= k "k") (= k "\u001b[A"))
      (assoc world :menu-sel (max 0 (dec sel)))

      ;; space/enter to confirm selection
      (and (or (= k " ") (= k "\r") (= k "\n")) (>= sel 0) (< sel (count items)))
      (let [[inv-idx item-id] (nth items sel)
            result (execute-menu-action world action inv-idx)]
        (if (:screen result)
          (dissoc result :menu-sel)
          (dissoc result :screen :menu-action :menu-sel :enchant-scroll-id)))

      ;; letter key — find matching item by inventory index and execute
      (and (= 1 (count k)) (some? (letter-to-index k)))
      (let [target-idx (letter-to-index k)
            match (first (filter (fn [[inv-idx _]] (= inv-idx target-idx)) items))]
        (if match
          (let [[inv-idx item-id] match
                result (execute-menu-action world action inv-idx)]
            (if (:screen result)
              (dissoc result :menu-sel)
              (dissoc result :screen :menu-action :menu-sel :enchant-scroll-id)))
          world))

      :else world)))

(defn message-page-size []
  (let [[_tw th] (term/size)]
    (max 1 (dec (render/message-visible-lines th)))))

(defn clamp-message-scroll [world scroll]
  (let [[_tw th] (term/size)
        visible-lines (render/message-visible-lines th)
        max-scroll (render/max-message-scroll world visible-lines)]
    (assoc world :message-scroll (max 0 (min max-scroll scroll)))))

(defn scroll-messages [world delta]
  (clamp-message-scroll world (+ (or (:message-scroll world) 0) delta)))

(defn close-messages-screen [world]
  (dissoc world :screen :message-scroll))

(defn messages-input [world k]
  (let [page (message-page-size)]
    (cond
      (or (= k "\u001b") (= k "q") (= k "m") (= k "\r"))
      (close-messages-screen world)

      (or (= k "k") (= k "\u001b[A"))
      (scroll-messages world 1)

      (or (= k "j") (= k "\u001b[B") (= k " "))
      (scroll-messages world -1)

      (or (= k "\u001b[5~") (= k "K"))
      (scroll-messages world page)

      (or (= k "\u001b[6~") (= k "J"))
      (scroll-messages world (- page))

      (= k "g")
      (let [[_tw th] (term/size)
            visible-lines (render/message-visible-lines th)]
        (clamp-message-scroll world (render/max-message-scroll world visible-lines)))

      (= k "G")
      (clamp-message-scroll world 0)

      :else world)))

(defn assemble-world
  "Build the starting world for `seed` and graft on its (seed-derived) title,
   scheme, and quest. Title/scheme/quest are cosmetic — they don't touch the
   gameplay seed chain — so this world replays identically to one made by
   new-game from the same seed."
  [seed title scheme quest]
  ;; Emit HUD startup from the common construction path, so replay (build-game)
  ;; populates the browser HUD's title/quest too — not only new-game. No-op on
  ;; native. Purely a side effect; the returned world is unchanged.
  (bridge/emit-startup title {:name (:item quest)})
  ;; Fresh run: drop any prior run's camera so a same-depth/same-viewport
  ;; restart re-centers on the player instead of inheriting the old offset.
  (render/reset-camera!)
  (-> (world/make-world 79 30 seed)
      (assoc :title title
             :scheme scheme
             :quest-item (:item quest))
      (#(reduce world/log-msg % (:messages quest)))))

(defn new-game []
  (let [sd  (seed/boot-seed)
        rng {:seed sd}
        {:keys [title scheme rng]} (title/show-title-screen rng)
        [quest rng] (title/generate-quest rng)
        _ (title/show-descending-screen 1 scheme)]
    (assemble-world sd title scheme quest)))

(defn build-game
  "Reconstruct a run's starting world from its seed, without the interactive
   title screen (same pick order as new-game: title -> scheme -> quest)."
  [seed]
  (let [rng {:seed seed}
        [title rng]  (title/generate-title rng)
        [scheme rng] (title/pick-scheme rng)
        [quest rng]  (title/generate-quest rng)]
    (assemble-world seed title scheme quest)))

;; The shell nudges a blocked read-key with a lone BEL (0x07) on a browser
;; resize so the game re-renders at the new size (see xsofy-shell.html
;; refit()). The modal screens below no longer block, so they re-fit from
;; their own render each frame and do not depend on the nudge — but it still
;; arrives, and a screen that dismisses on any key would treat it as one. Both
;; dismiss paths filter it exactly, the same bug xsofy.title guarded against
;; (space also parses to :unknown and must still count as a real dismiss key).
(def ^:private bel (str (char 7)))

(defn dismiss-input
  "Key reducer for screens that close on any key: clear :screen, except on the
   shell's lone-BEL resize nudge, which is not a keypress. EOF (nil) closes,
   matching the blocking path it replaces."
  [world k]
  (if (= k bel) world (dissoc world :screen)))

(defn modal-loop
  "Run a modal screen as a nested poll-based loop rather than blocking on
   read-key, so the loop stays live while the screen is open: a resize re-fits
   it (every render/*-screen reads term-dims itself), and under wasm the worker
   keeps pumping instead of stalling. See #82.

   `input` is the screen's own key reducer, called with the same raw key the
   blocking path passed it, so the key-to-world mapping is unchanged and
   replays are unaffected.

   Exits when :screen changes at all, not merely when it clears: the inventory
   and inscribe reducers hand off to each other, and the caller's `case` is what
   dispatches to the next screen's renderer."
  [world render! input]
  (let [from (:screen world)]
    (ui/run-loop
      {:sources  [(ui/input-source ui/raw-key->event) (ui/clock-source 0)]
       :state    world
       :step     (fn [w ev]
                   (let [[kind payload] ev]
                     (if (= kind :action)
                       ;; raw-key->event maps EOF to :eof; the reducers expect nil.
                       (let [w' (input w (if (= payload :eof) nil payload))]
                         (if (= (:screen w') from) w' (reduced w')))
                       w)))
       :render   render!
       :frame-ms 30})))

(defn prompt-key!
  "Poll for one real keypress while keeping a y/n prompt painted, returning the
   key (nil on EOF). The game screen underneath is repainted only when the
   terminal size changes, so an open prompt costs a prompt redraw per frame
   rather than a full-screen one."
  [world prompt]
  (let [painted (atom nil)]
    (ui/run-loop
      {:sources  [(ui/input-source ui/raw-key->event) (ui/clock-source 0)]
       :state    nil
       :step     (fn [st ev]
                   (let [[kind payload] ev]
                     (if (and (= kind :action) (not= payload bel))
                       (reduced (if (= payload :eof) nil payload))
                       st)))
       :render   (fn [_]
                   (let [size (term/size)]
                     (when (not= size @painted)
                       (reset! painted size)
                       (render/render-full world)))
                   (render/render-hazard-prompt world prompt))
       :frame-ms 30})))

(defn play-replay
  "Decode a replay code, reconstruct the run, and step through its actions with
   a short delay so the run plays out on screen. Returns the final world so the
   caller can hand control back to the player at the recorded end-state."
  [code]
  (let [{:keys [seed actions]} (replay/decode code)
        w0 (build-game seed)]
    (render/render-full w0)
    (bridge/emit-stats w0)
    (sfx/pause! 400)
    (reduce (fn [w action]
              (let [w' (dispatch/dispatch w action)]
                ;; Mirror the live loop (play/play-advance): an incremental
                ;; dirty render per turn, full repaint only on a floor change.
                ;; A full repaint every frame clears the whole screen first,
                ;; which reads as a blank-then-redraw flicker on playback (#110).
                (if (= (:depth w') (:depth w))
                  (render/render-dirty w' w)
                  (render/render-full w'))
                ;; Keep the HUD stats tracking the replay as it plays out.
                (bridge/emit-stats w')
                (sfx/pause! 90)
                w'))
            w0 actions)))

(defn game-loop
  ([world]
   (render/render-full world)
   (bridge/emit-stats world)
   (game-loop world world (term/size)))
  ([world prev-world prev-size]
   (if-not (:running world)
     world
     (let [screen (or (:screen world) :game)]
       (case screen
         :messages
         (let [w (modal-loop world render/render-messages-screen messages-input)]
           (if (:screen w)
             (recur w w prev-size)
             (do (render/render-full w)
                 (recur w w (term/size)))))

         :rune-codex
         (let [w (modal-loop world render/render-rune-codex dismiss-input)]
           (render/render-full w)
           (recur w w (term/size)))

         :help
         (let [w (modal-loop world render/render-help-screen dismiss-input)]
           (render/render-full w)
           (recur w w (term/size)))

         :inventory
         (let [w (modal-loop world render/render-inventory-screen inventory-input)]
           (if (:screen w)
             (recur w w prev-size)
             (do (render/render-full w)
                 (recur w w (term/size)))))

         :inscribe
         (let [w (modal-loop world render/render-inscribe-screen inscribe-input)]
           (if (:screen w)
             (recur w w prev-size)
             (do (render/render-full w)
                 (recur w w (term/size)))))

         :quick-menu
         (let [w (modal-loop world render/render-quick-menu quick-menu-input)]
           (if (:screen w)
             (recur w w prev-size)
             (do (render/render-full w)
                 (recur w w (term/size)))))

         :death
         (let [[tw th] (term/size)
               _ (sfx/clear-screen tw th)  ;; initial clear; the loop re-clears + re-scatters on resize
               ;; Capture this organic run's replay code at its final state. On
               ;; web this always fires: the shell's config pane renders the emit
               ;; as a player-facing ?replay= link (the live per-10-turn capture
               ;; in ui-bridge can lag a few turns; death re-emits exactly).
               ;; Natively it stays opt-in via XSOFY_DUMP_REPLAY (or the
               ;; ?dump-replay= param for parity).
               ;; Sink differs because *err* aliases *out* in WASM (one host writer
               ;; for both — let-go rendermain), so writing *err* there paints the
               ;; game screen. On web route the dump off-terminal via a js/emit host
               ;; event; natively keep stderr (redirect 2>file to capture past the TUI).
               _ (when-let [trig (or (js/url-param "dump-replay")
                                     (os/getenv "XSOFY_DUMP_REPLAY")
                                     (when (= (os/os-name) "js") "web"))]
                   (when (> (count trig) 0)
                     (let [code (replay/encode-run-safe world)
                           payload (or code "(unavailable: run has parameterized actions)")]
                       (if (= (os/os-name) "js")
                         (js/emit "xsofy/replay-dump" {:code payload :turn (or (:turn world) 0)})
                         (do (write! *err* (str "replay-code: " payload "\n"))
                             (flush! *err*))))))
               ;; Animate the death screen via the poll-based event loop: a
               ;; cosmetic clock pulses the runes each tick while we wait for a
               ;; key, instead of freezing on a blocking read (see xsofy.ui /
               ;; #56). :ui carries {:frame :scroll}; raw keys drive scroll/exit.
               step (fn [st ev]
                      (let [[tag payload] ev]
                        (case tag
                          :tick (let [cur (or (term/size) (:size st))]
                                  (if (= cur (:size st))
                                    (assoc st :frame payload)
                                    ;; resized: re-scatter + clear for the new size
                                    (let [[nw nh] cur]
                                      (sfx/clear-screen nw nh)
                                      (assoc st :frame payload :size cur
                                             :runes (render/death-runes nw nh)))))
                          :action
                          (let [k payload]
                            (cond
                              (or (= k "n") (= k "\r") (= k "\n") (= k " ")) (reduced :new-game)
                              (= k :eof)                  (reduced :quit)
                              (= k "\u001b")               (reduced :esc)
                              (or (= k "j") (= k "\u001b[B")) (update st :scroll (fn [s] (max 0 (dec s))))
                              (or (= k "k") (= k "\u001b[A")) (update st :scroll inc)
                              :else st))
                          st)))
               result (ui/run-loop
                        {:sources  [(ui/input-source ui/raw-key->event) (ui/clock-source 0)]
                         :state    {:frame 0 :scroll 0 :size [tw th] :runes (render/death-runes tw th)}
                         :step     step
                         :render   (fn [st] (render/render-death-screen world (:runes st) (:scroll st) (:frame st)))
                         :frame-ms 120})]
           (cond
             (= result :new-game)
             (let [w (new-game)]
               (render/render-full w)
               (recur w w (term/size)))
             ;; esc: wasm offers a restart confirm (declining re-enters the death
             ;; screen); native esc quits.
             (= result :esc)
             (if *in-wasm*
               (do
                 (if (= (prompt-key! world "Start a new game?") "y")
                   (let [w (new-game)]
                     (render/render-full w)
                     (recur w w (term/size)))
                   (recur world world prev-size)))
               (assoc world :running false))
             ;; :quit (EOF)
             :else (assoc world :running false)))

         :confirm-hazard
         (do
           ;; render the prompt on the message line
           (let [prompt (or (:hazard-prompt world) "Are you sure?")
                 k (prompt-key! world prompt)
                 w (if (= k "y")
                     (world/confirm-hazard-step world)
                     (world/cancel-hazard-step world))]
             (render/render-full w)
             (recur w w (term/size))))

         :confirm-quit
         (do
           (let [prompt (if *in-wasm*
                          "Are you sure you want to restart?"
                          "Are you sure you want to quit?")
                 k (prompt-key! world prompt)
                 w (if (= k "y")
                     (if *in-wasm*
                       (new-game)
                       (assoc world :running false))
                     (dissoc world :screen))]
             (if (:running w)
               (do
                 (render/render-full w)
                 (recur w w (term/size)))
               w)))

         :console
         ;; Quake-style dev REPL. The game is already on screen (the play loop
         ;; just drew it and toggling the console doesn't change the world), so
         ;; we do NOT repaint it here — the panel just draws over the top rows.
         ;; The only full repaint in the open/close cycle is on close, to erase
         ;; the panel. Runs on its own poll loop with a RAW-key source (line
         ;; editing needs literal chars, not parsed game actions). Returns the
         ;; world unchanged — the console is read-only (Cut 0). See xsofy.console.
         (let [size (term/size)
               result (ui/run-loop
                        ;; frame-ms 30 matches the play loop's input cadence (it
                        ;; floors to 30ms under wasm anyway) so typing feels the
                        ;; same as the game. Cheap now that render-console is
                        ;; dirty-checked — a faster loop won't repaint while idle.
                        {:sources  [(ui/input-source ui/raw-key->event) (ui/clock-source 0)]
                         :state    (console/init-state world size)
                         :step     console/handle-key
                         :render   console/render-console
                         :frame-ms 30})
               w (dissoc result :screen)]
           (render/render-full w)
           (recur w w (term/size)))

         ;; default: game screen — the poll-based turn loop (input +
         ;; clock-driven auto-actions / ambient animation); see run-play-loop.
         ;; (Per-turn bridge/emit-stats lives inside play/play-advance.)
         (let [result (play/run-play-loop world prev-size)]
           (if (:running result)
             (recur result result (term/size))
             result)))))))

(defn -main []
  (init-terminal)
  (try
    (let [code (seed/boot-replay)]
      (game-loop (if code (play-replay code) (new-game))))
    (catch e
           (dbg/log "FATAL ERROR:" e)
           (dbg/dump-crash! e)
      (shutdown-terminal)
      (println "FATAL ERROR:")
      (println e)
      (println "World state dumped to crash-dump.edn"))
    (finally
      (shutdown-terminal))))

(when-not *compiling-aot*
  (-main))
